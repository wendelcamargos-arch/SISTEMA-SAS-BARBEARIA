# ---- Núcleo ----
APP_ENV=development                 # development | production (production exige PostgreSQL e segredo)
DATABASE_URL=postgresql://barbearia:troque-esta-senha@localhost:5432/barbearia_dev
BARBEARIA_SECRET=troque-por-um-segredo-longo-e-aleatorio   # obrigatório em produção
ALLOWED_ORIGINS=https://app.suabarbearia.com.br            # CORS (separado por vírgula)
REDIS_URL=redis://localhost:6379/0                          # obrigatório em produção (rate limit)
APP_BASE_URL=http://localhost:8000                          # base dos links de e-mail

# ---- E-mail transacional (recuperação de senha) — sem SMTP_HOST usa provider simulado ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@suabarbearia.com.br
SMTP_STARTTLS=1

# ---- WhatsApp Business Cloud API (Meta) — ver docs/WHATSAPP_META_SETUP.md ----
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=defina-um-token-de-verificacao
META_APP_SECRET=

# ---- Demonstração (NUNCA em produção) ----
# DEMO_MODE=1
